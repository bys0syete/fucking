repeat task.wait() until unlocked

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer

local autoFarmEnabled = true
local isDashing = false

local NORMAL_WALK_SPEED = 35
local DASH_WALK_SPEED = 75
local JUMP_POWER = 50

StarterGui:SetCore("SendNotification", {
    Title = "DARKSP0T TEAM",
    Text = "Fixed E-Dash!\nHigher dash speed | Normal jump\nPress V to toggle",
    Duration = 8
})

print("DARKSP0T TEAM loaded! Press V to start/stop dash")

RunService.Heartbeat:Connect(function()
    local char = player.Character
    if not char then return end

    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end

    if autoFarmEnabled and not isDashing then
        humanoid.WalkSpeed = NORMAL_WALK_SPEED
        humanoid.JumpPower = JUMP_POWER
    end

    if humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
        task.wait(0.5)
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end

    if isDashing then
        humanoid.WalkSpeed = DASH_WALK_SPEED

        if humanoid:GetState() == Enum.HumanoidStateType.Landed or
           humanoid:GetState() == Enum.HumanoidStateType.Running then
            task.spawn(function()
                task.wait(0.035)
                if humanoid.Health > 0 then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode ~= Enum.KeyCode.V then return end

    isDashing = not isDashing

    local char = player.Character
    if not char then isDashing = false; return end

    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then isDashing = false; return end

    if isDashing then
        StarterGui:SetCore("SendNotification", {
            Title = "DARKSP0T TEAM",
            Text = "Emote Dash STARTED (High Speed)",
            Duration = 3
        })

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)

        task.wait(0.12)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
        task.wait(0.06)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)

    else
        StarterGui:SetCore("SendNotification", {
            Title = "DARKSP0T TEAM",
            Text = "Emote Dash STOPPED",
            Duration = 3
        })

        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
        humanoid.WalkSpeed = NORMAL_WALK_SPEED
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        autoFarmEnabled = not autoFarmEnabled

        StarterGui:SetCore("SendNotification", {
            Title = "DARKSP0T TEAM",
            Text = autoFarmEnabled and "Normal Speed ON" or "Normal Speed OFF",
            Duration = 3
        })
    end
end)

print("DARKSP0T TEAM | Press V to dash | RightShift to toggle normal speed")
